# Copy to .env and fill in. .env is gitignored — never commit real values.

DATABASE_URL=postgresql://edip:edip_dev@localhost:5434/edip

REDIS_HOST=localhost
REDIS_PORT=6383

# Graph store: `postgres` (default) or `falkordb`.
# With `falkordb`, Postgres stays the source of truth for entities and mentions
# — highlight offsets and cascade deletes live there — and the graph is mirrored
# into FalkorDB, which then answers every graph read in Cypher.
# Run `pnpm graph:sync` after switching, or the graph starts empty.
GRAPH_STORE_DRIVER=postgres
FALKORDB_HOST=localhost
FALKORDB_PORT=6384
FALKORDB_GRAPH=edip

# AWS / Bedrock.
# Both keys are required: the Bedrock SDK client passes `credentials: undefined`
# unless AWS_ACCESS_KEY_ID *and* AWS_SECRET_ACCESS_KEY are both present, which
# means a working `aws sts get-caller-identity` via SSO/profile is NOT enough.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Embedding model must produce 1024-dimension vectors to match the
# embedding_chunks.embedding column. Both of these do:
#   amazon.titan-embed-text-v2:0
#   cohere.embed-multilingual-v3
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_LLM_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

STORAGE_DIR=./storage

# Seed accounts, one per role. Passwords are hashed at seed time and never
# stored in plaintext. The viewer account is not optional: nothing is readable
# without signing in, so a read-only role needs a real login to demonstrate.
SEED_ADMIN_EMAIL=admin@ecloudvalley.demo
SEED_USER_EMAIL=user@ecloudvalley.demo
SEED_VIEWER_EMAIL=viewer@ecloudvalley.demo
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
SEED_VIEWER_PASSWORD=

PORT=3000
