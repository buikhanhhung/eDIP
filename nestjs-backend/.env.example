# Copy to .env and fill in. .env is gitignored — never commit real values.

DATABASE_URL=postgresql://edip:edip_dev@localhost:5434/edip

REDIS_HOST=localhost
REDIS_PORT=6383

# The knowledge graph. Entities, mentions and relations live only here — there
# is no Postgres table behind them, so FalkorDB must be running before
# `prisma db seed`, which writes the seeded entities straight into it.
FALKORDB_HOST=localhost
FALKORDB_PORT=6384
FALKORDB_GRAPH=edip

# Which provider answers the three model capabilities: embeddings, vision and
# structured extraction. `bedrock`, `openai` or `gemini`. Switching is a
# restart — stored vectors stay valid because all three emit 1024 dimensions.
AI_PROVIDER=bedrock

# Only needed when AI_PROVIDER=openai.
OPENAI_API_KEY=
# Leave empty for api.openai.com; set for Azure or a gateway.
OPENAI_BASE_URL=
OPENAI_LLM_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
# Must support the `dimensions` parameter, or the 1024-wide column breaks.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Only needed when AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
# Must support `outputDimensionality`. Gemini embeddings are Matryoshka, so the
# shortened vector is re-normalised in code before it is stored.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Only needed for models with a tight per-minute quota: gemini-2.5-flash allows
# 5 a minute on the free tier and one ingest issues ~6, so it wants 13000. The
# flash-lite models do not need pacing.
GEMINI_MIN_REQUEST_INTERVAL_MS=0

# AWS / Bedrock. Only needed when AI_PROVIDER=bedrock.
# Both keys are required: the Bedrock SDK client passes `credentials: undefined`
# unless AWS_ACCESS_KEY_ID *and* AWS_SECRET_ACCESS_KEY are both present, which
# means a working `aws sts get-caller-identity` via SSO/profile is NOT enough.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Embedding model must produce 1024-dimension vectors to match the
# embedding_chunks.embedding column. Both of these do:
#   amazon.titan-embed-text-v2:0
#   cohere.embed-multilingual-v3
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_LLM_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

STORAGE_DIR=./storage

# Seed accounts, one per role. Passwords are hashed at seed time and never
# stored in plaintext. The viewer account is not optional: nothing is readable
# without signing in, so a read-only role needs a real login to demonstrate.
SEED_ADMIN_EMAIL=admin@ecloudvalley.demo
SEED_USER_EMAIL=user@ecloudvalley.demo
SEED_VIEWER_EMAIL=viewer@ecloudvalley.demo
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
SEED_VIEWER_PASSWORD=

PORT=3000
