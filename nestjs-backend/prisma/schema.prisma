// Pinned to prisma-client-js on purpose: a fresh Prisma 7 scaffold defaults to
// the `prisma-client` generator, whose output is imported from a generated path
// rather than `@prisma/client` — which is what PrismaService imports.
generator client {
  provider = "prisma-client-js"
}

// No `url` here — it comes from prisma.config.ts.
datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  user
  viewer
}

enum DocumentStatus {
  uploaded
  processing
  completed
  failed
}

enum TextSource {
  native
  pdf_text
  docx
  xlsx
  pptx
  vision
}

/// Where a document entered the platform. Distinct from TextSource, which is
/// how its text was obtained once it was here.
enum DocumentSource {
  upload
  google_drive
}

/// What a model was asked to do. Named for the job rather than the API method,
/// because "how many tokens went on answering questions" is the question a
/// reader of the overview actually has.
enum TokenPurpose {
  /// Answering a question over the corpus.
  answer
  /// Classifying a document and pulling its metadata.
  analysis
  /// Naming entities and verifying them.
  entities
  /// Reading scans and images.
  vision
  /// Turning text into vectors, for both indexing and querying.
  embedding
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(viewer)
  createdAt    DateTime   @default(now())
  documents    Document[]
  auditLogs    AuditLog[]
  connections  SourceConnection[]
}

model Document {
  id          String @id @default(uuid())
  filename    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  ownerId     String
  owner       User   @relation(fields: [ownerId], references: [id])

  /// SHA-256 of the uploaded bytes, for spotting an exact re-upload.
  /// Nullable because rows predating the column were hashed by a backfill.
  contentHash String?

  /// Which door this came through. Defaults to `upload`, which is also the
  /// correct value for every row written before connectors existed.
  source DocumentSource @default(upload)

  status DocumentStatus @default(uploaded)
  error  String?

  documentType   String? // contract | invoice | report | policy | kyc | other
  typeConfidence Float?
  language       String?
  title          String?
  summary        String?
  textContent    String?
  textSource     TextSource?

  /// { parties: string[], date: string|null, amount: string|null, keywords: string[] }
  metadata           Json?
  metadataEditedById String?
  metadataEditedAt   DateTime?

  uploadedAt  DateTime  @default(now())
  processedAt DateTime?

  /// No entity relation here on purpose. Entities, their mentions and the
  /// relations between them live in FalkorDB and have no Postgres table —
  /// the same split ECVBot uses, where Postgres owns the source records and
  /// the graph owns the graph. `:Document` nodes in FalkorDB are a projection
  /// of these rows, keyed by this id.

  @@index([status])
  @@index([documentType])
  @@index([uploadedAt])
  @@index([contentHash])
  @@index([filename])
  @@index([source])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// One model call, and what it cost in tokens.
///
/// A row per call rather than a running total: totals cannot be sliced by date,
/// purpose or model afterwards, and the whole point of recording this is to be
/// able to ask which part of the pipeline is spending the budget.
///
/// `inputTokens` and `outputTokens` are what the provider reported. A provider
/// that reports nothing still gets a row, with zeros — the call happened, and a
/// missing row would understate how much work was done rather than how much it
/// cost.
model TokenUsage {
  id       String       @id @default(uuid())
  provider String // gemini | openai | bedrock
  model    String
  purpose  TokenPurpose

  inputTokens  Int @default(0)
  outputTokens Int @default(0)

  /// Characters sent, counted locally.
  ///
  /// Recorded because Gemini's embedding endpoint reports no token usage at all
  /// — only a billable character count, and only on its enterprise platform. A
  /// character count is a real measurement of the same work, which beats
  /// dividing by four and calling the result tokens.
  inputChars Int @default(0)

  /// True when the provider returned token figures for this call, so a zero is
  /// not mistaken for a free request.
  reported Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([purpose])
}

/// Modelled even though `vector` is an unsupported column type. Leaving the
/// table out of the schema entirely makes the next `migrate dev` emit
/// `DROP TABLE embedding_chunks` as a drift correction.
model EmbeddingChunk {
  id               Int      @id @default(autoincrement())
  documentId       String   @map("document_id")
  content          String
  parentContent    String?  @map("parent_content")
  chunkingStrategy String?  @map("chunking_strategy")
  chunkIndex       Int?     @map("chunk_index")
  metadata         Json?
  embedding        Unsupported("vector(1024)")?
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([documentId])
  @@map("embedding_chunks")
}

/// A user's connection to an external document source.
///
/// Tokens are stored encrypted; nothing here is ever returned from an API
/// response. One row per owner and provider — reconnecting replaces it rather
/// than accumulating grants nobody can see or revoke.
model SourceConnection {
  id       String @id @default(uuid())
  provider String // google_drive

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  /// The connected account, shown so a reader knows whose Drive this is.
  accountEmail String?

  /// AES-256-GCM, "iv:tag:ciphertext". Never logged, never serialised out.
  accessToken     String
  refreshToken    String?
  accessExpiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, provider])
  @@index([provider])
}
